menu() {
  clear
  echo -e "${BLUE}WeirdTreeThing Chromebook Audio Script${RESET}"
  echo -e " ${YELLOW}1) ${GREEN}Install audio fixes${RESET}"
  echo -e " ${YELLOW}2) ${GREEN}Remove audio fixes${RESET}"
  echo -e " ${YELLOW}3) ${GREEN}Clear audio state${RESET}"
  echo -e " ${YELLOW}4) ${GREEN}Collect debugging logs${RESET}"
  echo -e " ${YELLOW}5) ${GREEN}Exit${RESET}"

  echo -en "${BLUE} Selection: ${RESET}"
  read -re opt
  case $opt in

  1)
    install_fixes
    ;;
  2)
    echo_error "Currently not implemented"
    ;;
  3)
    echo_error "Currently not implemented"
    ;;
  4)
    echo_error "Currently not implemented"
    ;;
  5)
    exit
    ;;
  *)
    menu
    ;;

  esac
}

check_omarchy
check_nix
check_arch

# Parse options
while getopts ":fhp:b:" flag; do
  case $flag in
    f)
      FORCE_AVS_INSTALL=true
      ;;
    h)
      usage
      ;;
    p)
      OVERRIDE_PLATFORM=$OPTARG
      ;;
    b)
      OVERRIDE_BRANCH=$OPTARG
      ;;
    *)
      usage
      ;;
  esac
done

# Check if we are running as root, and restart the script if not
if [ ! "$(id -u)" = "0"  ]; then
  if command -v sudo >/dev/null 2>&1; then
    echo "Using sudo for escalation"
    exec sudo "$0" "$@"
  elif command -v doas >/dev/null 2>&1; then
    echo "Using doas for escalation"
    exec doas "$0" "$@"
  elif command -v su >/dev/null 2>&1; then
    echo "Falling back to su for escalation"
    echo "Please enter the password for the ROOT account of the system"
    exec su root -c '"$0" "$@"' -- "$0" "$@"
  else
    echo "ERROR: No supported privilege escalation tool found."
    echo "Run this script as root instead."
    exit 1
  fi
fi

menu
